// =============================================================================
//  Корпус Orange Pi 4 с вентилятором 40×40 (5 В, 4010 или 4007) на крышке
// =============================================================================
//  Основание общее с case_30.scad — печатается одно и то же.
//  PART: "assembly" — сборка с платой; "exploded" — разнесённый вид;
//        "base" / "lid" — детали в положении для печати; "cut" — разрез;
//        "template" — шаблон для проверки размеров по плате (печать ~10 мин).
//  Экспорт из командной строки:
//    openscad -o stl/case_base.stl  -D 'PART="base"' case_40.scad
//    openscad -o stl/case40_lid.stl -D 'PART="lid"'  case_40.scad
// =============================================================================
include <opi4_board.scad>
include <opi4_case_lib.scad>
OPI4_STANDALONE = false;

PART = "assembly";   // [assembly, exploded, base, lid, cut, template]

FAN_SIZE = 40;
// Вентилятор сдвинут на 4,5 мм от SoC к передней кромке, чтобы его рамка не
// заходила на проём гребёнки 40 pin. Радиатор 20×20 при этом целиком под ним.
FAN_CX = SOC_X;
FAN_CY = SOC_Y - 4.5;

$fn = 48;
opi4_case(PART, FAN_SIZE, FAN_CX, FAN_CY);
