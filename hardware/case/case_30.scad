// =============================================================================
//  Корпус Orange Pi 4 с вентилятором 30×30 (3007 / 3010) на крышке
// =============================================================================
//  Основание общее с case_40.scad — печатается одно и то же.
//  PART: "assembly" — сборка с платой; "exploded" — разнесённый вид;
//        "base" / "lid" — детали в положении для печати; "cut" — разрез;
//        "template" — шаблон для проверки размеров по плате (печать ~10 мин).
//  Экспорт:
//    openscad -o stl/case30_lid.stl -D 'PART="lid"' case_30.scad
//
//  Сейчас вентилятор 12-вольтовый от 5 В — дует слабо; в корпусе ему будет
//  ещё тяжелее (сопротивление щелей). Для полных частот лучше case_40.
// =============================================================================
include <opi4_board.scad>
include <opi4_case_lib.scad>
OPI4_STANDALONE = false;

PART = "assembly";   // [assembly, exploded, base, lid, cut, template]

FAN_SIZE = 30;
FAN_CX = SOC_X;      // точно над SoC: рамка 30 мм не доходит до гребёнки
FAN_CY = SOC_Y;
FAN_THICK = 10;      // 3010; для 3007 поставьте 7 (влияет только на превью)

$fn = 48;
opi4_case(PART, FAN_SIZE, FAN_CX, FAN_CY);
