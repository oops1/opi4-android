// =============================================================================
//  Orange Pi 4 (RK3399, v1.3, не LTS) — модель платы, размеры и позиции разъёмов
// =============================================================================
//  Общий файл для fan_mount_40.scad, case_30.scad, case_40.scad.
//  Подключается через include <opi4_board.scad>; любой параметр можно
//  переопределить в подключающем файле ПОСЛЕ include.
//
//  Откуда размеры:
//    * 91 × 55,7 мм — официальная спецификация (orangepi.org wiki, «Dimension»).
//    * Остальное снято с официальных фото платы (вики Orange Pi 4, вид сверху и
//      снизу, ~7,6 пикс/мм), копии лежат в ref/. Точность ±0,3…0,5 мм.
//    * Высоты компонентов — типовые для этих разъёмов, НЕ замерены.
//  Всё, что помечено  [ПРОВЕРИТЬ], надо промерить штангенциркулем до печати
//  (список и порядок замеров — в README.md).
//
//  Система координат (вид на плату сверху, сторона с SoC):
//    X — вдоль длинной стороны 91 мм, Y — вдоль короткой 55,7 мм, Z — вверх.
//    Начало координат — угол платы, где сходятся:
//      передняя кромка  F (Y = 0)      : аудио 3,5 мм, HDMI, USB-C, DC 5 В
//      левая кромка     L (X = 0)      : шлейфы камер/LCD (наружу ничего не нужно)
//    правая кромка   R (X = PCB_L) : USB3.0+USB2.0 (стек), Ethernet, USB2.0
//    задняя кромка   B (Y = PCB_W) : гребёнка 40 pin (сверху), microSD (снизу)
//    Z = 0 — НИЖНЯЯ поверхность платы, PCB_T — верхняя.
// =============================================================================

/* [Плата] */
PCB_L = 91.0;        // длина
PCB_W = 55.7;        // ширина
PCB_T = 1.6;         // толщина          [ПРОВЕРИТЬ]
PCB_R = 2.0;         // радиус углов

/* [Крепёжные отверстия] */
HOLE_D    = 3.0;     // диаметр отверстий в плате (под M2.5 с зазором)  [ПРОВЕРИТЬ]
HOLE_IN_X = 3.0;     // центр отверстия от короткой кромки (L/R)       [ПРОВЕРИТЬ]
HOLE_IN_Y = 2.35;    // центр отверстия от длинной кромки (F/B)        [ПРОВЕРИТЬ]
// межцентровые расстояния получаются 85,0 × 51,0 мм
function opi4_holes() = [
    [HOLE_IN_X,         HOLE_IN_Y],          // 0: перед-лево  (у аудиоразъёма)
    [PCB_L - HOLE_IN_X, HOLE_IN_Y],          // 1: перед-право (у стека USB)
    [HOLE_IN_X,         PCB_W - HOLE_IN_Y],  // 2: зад-лево    (у края гребёнки)
    [PCB_L - HOLE_IN_X, PCB_W - HOLE_IN_Y],  // 3: зад-право   (у одиночного USB)
];

/* [SoC и радиатор] */
SOC_X = 38.8;        // центр RK3399                                   [ПРОВЕРИТЬ]
SOC_Y = 33.1;        //                                                 [ПРОВЕРИТЬ]
SOC_SIZE = 21.0;     // корпус FCBGA 21×21 (на плате повёрнут ~45°)
SOC_H = 1.8;         // высота SoC над платой                          [ПРОВЕРИТЬ]
HS_SIZE = 20.0;      // радиатор 20×20 (игольчатый, на термоскотче)     [ПРОВЕРИТЬ]
HS_H = 17.0;         // высота радиатора без подложки                   [ПРОВЕРИТЬ]
HS_TAPE = 0.3;       // термоскотч / прокладка
HS_X = SOC_X;        // радиатор может быть приклеен со смещением —     [ПРОВЕРИТЬ]
HS_Y = SOC_Y;
HS_ROT = 0;          // поворот радиатора: 0 — стороны вдоль краёв платы,  [ПРОВЕРИТЬ]
                     // 45 — повёрнут вместе с SoC (сам SoC на плате стоит под 45°)
// верх радиатора над ВЕРХНЕЙ поверхностью платы
function hs_top() = SOC_H + HS_TAPE + HS_H;     // ≈ 19,1 мм

/* [Гребёнка 40 pin] */
// Пин 1 (квадратная площадка) — в ряду у задней кромки, на конце ближе к SoC.
// Чётные пины (2 = 5V, 4 = 5V, 6 = GND, 8 = TXD, 10 = RXD) — во внутреннем ряду.
HDR_PIN1_X = 55.1;   // X пина 1                                       [ПРОВЕРИТЬ]
HDR_ROW_OUT_Y = 54.85; // ряд нечётных пинов (у кромки)                 [ПРОВЕРИТЬ]
HDR_PITCH = 2.54;
HDR_H = 8.5;         // высота штырей над платой
HDR_DUPONT_H = 16.5; // верх надетых разъёмов Dupont над платой
function hdr_pin(n) = [                       // координаты пина n (1…40)
    HDR_PIN1_X - floor((n - 1) / 2) * HDR_PITCH,
    (n % 2 == 1) ? HDR_ROW_OUT_Y : HDR_ROW_OUT_Y - HDR_PITCH ];
HDR_X0 = hdr_pin(39)[0] - 1.27;   // габарит пластмассы гребёнки
HDR_X1 = hdr_pin(1)[0]  + 1.27;
HDR_Y0 = hdr_pin(2)[1]  - 1.27;
HDR_Y1 = hdr_pin(1)[1]  + 1.27;

// 3-контактный отладочный UART (отдельный, у левой кромки)
DBG_X = 5.7;  DBG_Y0 = 43.5;  DBG_Y1 = 48.6;                 //        [ПРОВЕРИТЬ]

/* [Светодиоды, кнопки] */
LED_X = 24.2;  LED_Y = 50.2;   // LED1/LED2 (питание/статус) у гребёнки  [ПРОВЕРИТЬ]
BTN_RESET   = [61.8, 29.9];    // кнопка Reset, НИЖНЯЯ сторона платы    [ПРОВЕРИТЬ]
BTN_RECOVER = [10.9, 16.1];    // кнопка Recovery/Upgrade, НИЖНЯЯ сторона [ПРОВЕРИТЬ]
// ИК-приёмника на Orange Pi 4 v1.3 нет (на фото его нет). Если припаяете
// свой — включите IR_ENABLE в файлах корпуса и задайте позицию.
IR_X = 80.0;  IR_Y = 3.0;

/* [Нижняя сторона] */
BOTTOM_PARTS_H = 2.5;  // самый высокий компонент снизу (слот microSD, FPC) [ПРОВЕРИТЬ]

// -----------------------------------------------------------------------------
//  Разъёмы на кромках.
//  [имя, кромка, начало, конец (вдоль кромки, мм), высота над платой (+ сверху,
//   − снизу платы), вылет за кромку платы]
//  «начало/конец» — X для кромок F/B, Y для кромок L/R.
// -----------------------------------------------------------------------------
CONNECTORS = [
    ["audio",  "F",  7.0, 13.0,  6.0, 0.5],   // 3,5 мм, гнездо смотрит вперёд [ПРОВЕРИТЬ]
    ["hdmi",   "F", 17.4, 32.2,  6.5, 1.5],   // HDMI 2.0 type A              [ПРОВЕРИТЬ]
    ["usbc",   "F", 36.2, 45.1,  3.4, 1.0],   // USB3.0 Type-C (данные/DP/питание)
    ["dc",     "F", 61.1, 69.0, 11.0, 1.5],   // DC 5 В 4,0/1,7 мм — высоту [ПРОВЕРИТЬ]
    ["usb3",   "R",  4.5, 20.3, 16.0, 2.0],   // стек USB3.0 + USB2.0        [ПРОВЕРИТЬ]
    ["eth",    "R", 23.6, 39.7, 13.6, 2.0],   // RJ45 Gigabit               [ПРОВЕРИТЬ]
    ["usb2",   "R", 43.4, 49.6, 15.0, 1.5],   // одиночный USB2.0 (стоячий) [ПРОВЕРИТЬ]
    ["sd",     "B", 57.2, 73.0, -1.8, 0.0],   // microSD, снизу платы       [ПРОВЕРИТЬ]
];

// Цвета для превью
C_PCB = [0.10, 0.35, 0.75];
C_MET = [0.75, 0.75, 0.78];
C_BLK = [0.12, 0.12, 0.12];

// =============================================================================
//  Вспомогательные модули
// =============================================================================
module rrect(l, w, h, r) {            // скруглённый прямоугольник от (0,0,0)
    rr = max(min(r, l / 2 - 0.01, w / 2 - 0.01), 0.01);
    hull() for (x = [rr, l - rr], y = [rr, w - rr])
        translate([x, y, 0]) cylinder(r = rr, h = h);
}

module hexagon(af, h) {               // шестигранник «под ключ» af
    cylinder(d = af / cos(30), h = h, $fn = 6);
}

// Параллелепипед разъёма в координатах платы. grow — увеличение по всем
// сторонам (кроме наружной, она уходит на ext мм за кромку).
module connector_box(c, grow = 0, ext = 0, ztop_extra = 0) {
    edge = c[1]; a = c[2]; b = c[3]; h = c[4]; ov = c[5];
    depth = 14;                                  // глубина внутрь платы (для превью)
    z0 = (h >= 0 ? PCB_T : -abs(h)) - grow;
    zh = abs(h) + 2 * grow + ztop_extra + (h >= 0 ? 0 : 0);
    if (edge == "F")
        translate([a - grow, -ov - ext, z0]) cube([b - a + 2 * grow, depth + ov + ext, zh]);
    if (edge == "B")
        translate([a - grow, PCB_W - depth, z0]) cube([b - a + 2 * grow, depth + ov + ext, zh]);
    if (edge == "R")
        translate([PCB_L - depth, a - grow, z0]) cube([depth + ov + ext, b - a + 2 * grow, zh]);
    if (edge == "L")
        translate([-ov - ext, a - grow, z0]) cube([depth + ov + ext, b - a + 2 * grow, zh]);
}

// =============================================================================
//  Модель платы (для превью и проверки коллизий)
// =============================================================================
module opi4_board(with_heatsink = true, with_dupont = true) {
    // текстолит
    color(C_PCB) difference() {
        rrect(PCB_L, PCB_W, PCB_T, PCB_R);
        for (h = opi4_holes()) translate([h[0], h[1], -1]) cylinder(d = HOLE_D, h = PCB_T + 2, $fn = 24);
    }
    // разъёмы
    for (c = CONNECTORS) {
        d = (c[0] == "audio") ? 12 : (c[0] == "usb3" || c[0] == "eth") ? 15 :
            (c[0] == "usb2") ? 13 : (c[0] == "sd") ? 15 : 11;
        color(c[0] == "audio" || c[0] == "dc" ? C_BLK : C_MET)
        intersection() {
            connector_box(c);
            // ограничим глубину разъёма
            if (c[1] == "F") translate([-50, -10, -10]) cube([200, d + 10, 50]);
            else if (c[1] == "B") translate([-50, PCB_W - d, -10]) cube([200, d + 10, 50]);
            else if (c[1] == "R") translate([PCB_L - d, -50, -10]) cube([d + 10, 200, 50]);
            else translate([-10, -50, -10]) cube([d + 10, 200, 50]);
        }
    }
    // SoC (повёрнут на 45°)
    color([0.85, 0.85, 0.82]) translate([SOC_X, SOC_Y, PCB_T])
        rotate(45) translate([-SOC_SIZE / 2, -SOC_SIZE / 2, 0]) cube([SOC_SIZE, SOC_SIZE, SOC_H]);
    if (with_heatsink) opi4_heatsink();
    // гребёнка 40 pin
    color(C_BLK) translate([HDR_X0, HDR_Y0, PCB_T]) cube([HDR_X1 - HDR_X0, HDR_Y1 - HDR_Y0, 2.5]);
    color([0.9, 0.75, 0.2]) for (n = [1:40]) translate([hdr_pin(n)[0] - 0.32, hdr_pin(n)[1] - 0.32, PCB_T])
        cube([0.64, 0.64, HDR_H]);
    if (with_dupont)       // переходник UART (пины 6, 8, 10) и вентилятор (4, 6)
        color([0.2, 0.2, 0.2, 0.6]) for (n = [4, 6, 8, 10])
            translate([hdr_pin(n)[0] - 1.25, hdr_pin(n)[1] - 1.25, PCB_T + 2.5]) cube([2.5, 2.5, 14]);
    // отладочный UART
    color(C_BLK) translate([DBG_X - 1.27, DBG_Y0 - 1.27, PCB_T]) cube([2.54, DBG_Y1 - DBG_Y0 + 2.54, 2.5]);
    // светодиоды
    color([1, 0.2, 0.2]) translate([LED_X - 1, LED_Y - 0.6, PCB_T]) cube([2, 1.2, 0.8]);
    // кнопки снизу
    color([0.9, 0.9, 0.9]) for (b = [BTN_RESET, BTN_RECOVER])
        translate([b[0] - 1.5, b[1] - 1.5, -1.5]) cube([3, 3, 1.5]);
}

module opi4_heatsink() {
    color([0.3, 0.3, 0.32]) translate([HS_X, HS_Y, PCB_T + SOC_H + HS_TAPE])
        rotate(HS_ROT) translate([-HS_SIZE / 2, -HS_SIZE / 2, 0]) {
        cube([HS_SIZE, HS_SIZE, 2]);
        n = 6; p = HS_SIZE / n;
        for (i = [0:n - 1], j = [0:n - 1])
            translate([p * (i + 0.5) - 0.9, p * (j + 0.5) - 0.9, 0]) cube([1.8, 1.8, HS_H]);
    }
}

// Вентилятор (для превью): size × size × thick, нижняя грань на z = 0, центр в (0,0)
module fan_model(size = 40, thick = 10) {
    color([0.15, 0.15, 0.15, 0.85]) difference() {
        translate([-size / 2, -size / 2, 0]) rrect(size, size, thick, 2);
        translate([0, 0, -1]) cylinder(d = size - 2, h = thick + 2, $fn = 64);
    }
    color([0.25, 0.25, 0.25, 0.85]) {
        cylinder(d = size * 0.35, h = thick, $fn = 32);
        for (a = [0:72:359]) rotate(a) translate([0, -1, thick * 0.3]) rotate([20, 0, 0])
            cube([size / 2 - 1.5, 2, 0.8]);
    }
}

// Шаг крепёжных отверстий вентилятора
function fan_pitch(size) = (size == 40) ? 32 : (size == 30) ? 24 : (size == 25) ? 20 : size * 0.8;

// Превью самой платы, если открыть этот файл напрямую.
// Файлы, которые делают include, ставят OPI4_STANDALONE = false.
OPI4_STANDALONE = true;
if (OPI4_STANDALONE) opi4_board($fn = 32);
