# brcmfmac (AP6256) asks for its vendor module 'brcmfmac-wcc' with request_module(), which needs
# /sbin/modprobe - Android has none. Load wcc up front; modprobe pulls brcmfmac in as a dependency.
# brcmfmac itself is blocklisted for ueventd (modules.blocklist) so it never loads without wcc.
on early-init
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor/lib/modules -a brcmfmac-wcc

# hci_uart_bcm is built in and probes before /vendor is mounted, so the BT patch file
# (brcm/BCM4345C5.hcd in /vendor/etc/firmware) is missing. Rebind once /vendor is there.
on early-init
    write /sys/bus/serial/drivers/hci_uart_bcm/unbind serial0-0
    write /sys/bus/serial/drivers/hci_uart_bcm/bind serial0-0

# 26-pin header (dev build): let apps export GPIOs through the legacy sysfs interface
on boot
    chmod 0222 /sys/class/gpio/export
    chmod 0222 /sys/class/gpio/unexport
    # PWM1 (GPIO4_C6) is the only PWM on the header; PWM0/2 drive board functions
    # (PWM2 is usually the vdd_log regulator), so keep them root-only. Exported pwm
    # channels carry no subsystem, ueventd cannot fix them up: export it here.
    write /sys/class/pwm/pwmchip1/export 0
    chmod 0666 /sys/class/pwm/pwmchip1/pwm0/period
    chmod 0666 /sys/class/pwm/pwmchip1/pwm0/duty_cycle
    chmod 0666 /sys/class/pwm/pwmchip1/pwm0/polarity
    chmod 0666 /sys/class/pwm/pwmchip1/pwm0/enable

# Debug builds start a shell on the serial console from init.rc, and SystemUI then warns
# "serial console enabled, performance is impacted". ADB is enough day to day: keep it off
# unless persist.vendor.opi4.console=1 (kernel messages and U-Boot stay on ttyS2 anyway).
on boot && property:persist.vendor.opi4.console=0
    stop console

on property:persist.vendor.opi4.console=1
    start console
