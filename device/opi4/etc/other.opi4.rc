# brcmfmac (AP6256) asks for its vendor module 'brcmfmac-wcc' with request_module(), which needs
# /sbin/modprobe - Android has none. Load wcc up front; modprobe pulls brcmfmac in as a dependency.
# brcmfmac itself is blocklisted for ueventd (modules.blocklist) so it never loads without wcc.
on early-init
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor/lib/modules -a brcmfmac-wcc

# hci_uart_bcm is built in and probes before /vendor is mounted, so the BT patch file
# (brcm/BCM4345C5.hcd in /vendor/etc/firmware) is missing. Rebind once /vendor is there.
on early-init
    write /sys/bus/serial/drivers/hci_uart_bcm/unbind serial0-0
    write /sys/bus/serial/drivers/hci_uart_bcm/bind serial0-0

# 26-pin header (dev build): let apps export GPIOs through the legacy sysfs interface
on boot
    chmod 0222 /sys/class/gpio/export
    chmod 0222 /sys/class/gpio/unexport
    chmod 0222 /sys/class/pwm/pwmchip0/export
    chmod 0222 /sys/class/pwm/pwmchip0/unexport
    chmod 0222 /sys/class/pwm/pwmchip1/export
    chmod 0222 /sys/class/pwm/pwmchip1/unexport
    chmod 0222 /sys/class/pwm/pwmchip2/export
    chmod 0222 /sys/class/pwm/pwmchip2/unexport
