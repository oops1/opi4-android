# Orange Pi 4 (RK3399) fragment on top of arm64 defconfig + GloDroid Android fragments.
# Drivers needed early or by HALs are built in (=y); the rest stays as in defconfig.

# Display: VOP, HDMI, Type-C DP, GPU (Panfrost)
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP=y
CONFIG_ROCKCHIP_DW_HDMI=y
CONFIG_ROCKCHIP_CDN_DP=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_DRM_DW_HDMI_CEC=y
CONFIG_DRM_PANFROST=y
CONFIG_PHY_ROCKCHIP_TYPEC=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_PHY_ROCKCHIP_EMMC=y
CONFIG_TYPEC=y
CONFIG_TYPEC_FUSB302=y
CONFIG_TYPEC_TCPM=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_TYPEC_EXTCON=y
CONFIG_EXTCON_USB_GPIO=y

# Video: rkvdec (H.264/HEVC/VP9), Hantro (MPEG-2/VP8, JPEG enc), RGA
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_MEDIA_CONTROLLER_REQUEST_API=y
CONFIG_VIDEO_DEV=y
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_STAGING=y
CONFIG_STAGING_MEDIA=y
CONFIG_VIDEO_ROCKCHIP_VDEC=y
CONFIG_VIDEO_HANTRO=y
CONFIG_VIDEO_HANTRO_ROCKCHIP=y
CONFIG_VIDEO_ROCKCHIP_RGA=y
CONFIG_CEC_CORE=y
CONFIG_CEC_NOTIFIER=y

# Audio: I2S + RT5651 analog codec, HDMI audio, SPDIF
CONFIG_SND_SOC_ROCKCHIP=y
CONFIG_SND_SOC_ROCKCHIP_I2S=y
CONFIG_SND_SOC_ROCKCHIP_SPDIF=y
CONFIG_SND_SOC_RT5651=y
CONFIG_SND_SOC_HDMI_CODEC=y
CONFIG_SND_SOC_SPDIF=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_AUDIO_GRAPH_CARD=y

# Storage
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_OF_ARASAN=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y

# PMIC, regulators, clocks, thermal, DVFS
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR_RK808=y
CONFIG_REGULATOR_FAN53555=y
CONFIG_REGULATOR_PWM=y
CONFIG_COMMON_CLK_RK808=y
CONFIG_RTC_DRV_RK808=y
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_ROCKCHIP_IODOMAIN=y
CONFIG_ROCKCHIP_PM_DOMAINS=y
CONFIG_CPUFREQ_DT=y
CONFIG_PM_DEVFREQ=y
CONFIG_SENSORS_PWM_FAN=y

# Ethernet (RTL8211E on GMAC)
CONFIG_STMMAC_ETH=y
CONFIG_DWMAC_ROCKCHIP=y
CONFIG_REALTEK_PHY=y

# Wi-Fi / BT (AP6256): module so firmware from /vendor is available when it loads
CONFIG_CFG80211=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_NVMEM=y
CONFIG_POWER_SEQUENCING=y

# IR receiver and input
CONFIG_RC_CORE=y
CONFIG_LIRC=y
CONFIG_RC_DECODERS=y
CONFIG_IR_NEC_DECODER=y
CONFIG_RC_DEVICES=y
CONFIG_IR_GPIO_CIR=y
CONFIG_KEYBOARD_ADC=y
CONFIG_ROCKCHIP_SARADC=y

# Android 12+ appends bootconfig to the initramfs; without this the kernel rejects the ramdisk
# ("rootfs image is not initramfs (invalid magic at start of compressed archive)")
CONFIG_BOOT_CONFIG=y

# Android init mounts cpuset as a cgroup v1 hierarchy (/dev/cpuset); since Linux 6.12 that
# needs CPUSETS_V1, otherwise: "cgroup: Unknown subsys name 'cpuset'" -> SetupCgroups fails
# -> ueventd/apexd cannot start -> reboot to bootloader.
CONFIG_CPUSETS_V1=y

# Bring-up: report lockups on the console instead of freezing silently
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR_PREFER_BUDDY=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=60
CONFIG_WQ_WATCHDOG=y
CONFIG_ROCKCHIP_RK3399_WDT=y
CONFIG_DW_WATCHDOG=y
CONFIG_WATCHDOG=y

# No DWARF debug info: with ~1150 modules from the arm64 defconfig it made vendor_dlkm 1.1 GB
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set

# Serial console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y

# Android shared memory (needed by system_server, patch 0007)
CONFIG_STAGING=y
CONFIG_ASHMEM=y

# Android netd uses legacy iptables (iptables-restore v1.8 legacy); 6.17+ hides it behind *_LEGACY.
# Options below are from kernel/configs/c/android-6.12/android-base.config.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_SECURITY=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MATCH_RPFILTER=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_NETMAP=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_NF_ARPTABLES=y
CONFIG_IP_NF_ARPFILTER=y
CONFIG_IP_NF_ARP_MANGLE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_MATCH_RPFILTER=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_CT=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NETFILTER_XT_TARGET_TRACE=y

# Parents are =m in arm64 defconfig, which clamps our =y children to modules. Build them in.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_BT=y

# 26-pin header for userspace: legacy /sys/class/gpio (dev board habit, needs EXPERT),
# /dev/spidevX.Y built in (SPI1 on the header)
CONFIG_EXPERT=y
CONFIG_GPIO_SYSFS=y
CONFIG_SPI_SPIDEV=y
# EXPERT flips these defaults off; keep them as they were without it
CONFIG_FHANDLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_DUMMY_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONT_8x8=y
CONFIG_MEDIA_HIDE_ANCILLARY_SUBDRV=y
