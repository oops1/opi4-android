# GPU / display (libdrm's drmGetDevice reads uevent, Mesa reads the GPU node)
genfscon sysfs /devices/platform/display-subsystem                     u:object_r:sysfs_gpu:s0
genfscon sysfs /devices/platform/ff9a0000.gpu                          u:object_r:sysfs_gpu:s0
# SD card and eMMC hosts (storaged, vold, fs tools read block queue/stat)
genfscon sysfs /devices/platform/fe320000.mmc                          u:object_r:sysfs_devices_block:s0
genfscon sysfs /devices/platform/fe330000.mmc                          u:object_r:sysfs_devices_block:s0
# USB-C power input (fusb302) for the health HAL, Type-C extcon
genfscon sysfs /devices/platform/ff3d0000.i2c/i2c-4/4-0022/power_supply u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/platform/ff3d0000.i2c/i2c-4/4-0022/power_supply/tcpm-source-psy-4-0022/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/typec-extcon/extcon                   u:object_r:sysfs_extcon:s0
genfscon sysfs /devices/platform/ff770000.syscon/ff770000.syscon:usb2phy@e450/extcon u:object_r:sysfs_extcon:s0
genfscon sysfs /devices/platform/ff770000.syscon/ff770000.syscon:usb2phy@e460/extcon u:object_r:sysfs_extcon:s0
# RK808 RTC wakeup source (system_suspend reads the names)
genfscon sysfs /devices/platform/ff3c0000.i2c/i2c-0/0-001b/rk808-rtc.5.auto/wakeup u:object_r:sysfs_wakeup:s0
# Other wakeup sources listed in /sys/class/wakeup (system_suspend reads their stats;
# USB ones depend on the port and only cost statistics)
genfscon sysfs /devices/platform/ff3c0000.i2c/i2c-0/0-001b/wakeup     u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/ff3c0000.i2c/i2c-0/0-001b/rk808-rtc.5.auto/rtc/rtc0/alarmtimer.6.auto/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/ff180000.serial/ff180000.serial:0/ff180000.serial:0.0/serial0/serial0-0/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/gpio-keys/wakeup                     u:object_r:sysfs_wakeup:s0
