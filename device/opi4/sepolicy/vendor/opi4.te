# Orange Pi 4 board policy on top of GloDroid. GloDroid runs permissive by default, so
# these rules come from the denials of a permissive run (needed for 'user' builds,
# which are always enforcing).

# --- Graphics: minigbm_gd hands out memfd-backed buffers that live in the allocator's
# tmpfs; every client maps them.
allow {
  appdomain
  -isolated_app_all
  bootanim
  surfaceflinger
  system_server
  hal_graphics_composer_default
  mediacodec
  mediaswcodec
  cameraserver
} hal_graphics_allocator_default_tmpfs:file { getattr read write map };
hal_client_domain(hal_graphics_composer_default, hal_graphics_allocator)
# Apps run with MLS categories; the shared buffers are level s0.
typeattribute hal_graphics_allocator_default_tmpfs mlstrustedobject;

# GloDroid labels /dev/video0 as a camera (Raspberry Pi); here it is the rkvdec/Hantro decoder.
allow mediacodec camera_device:chr_file rw_file_perms;

# ffmpeg_codec2 options (persist.ffmpeg_codec2.*), set from its init script, read by mediacodec
vendor_internal_prop(vendor_ffmpeg_codec2_prop)
set_prop(vendor_init, vendor_ffmpeg_codec2_prop)
get_prop(mediacodec, vendor_ffmpeg_codec2_prop)

# Block device stats on the SD/eMMC hosts, queue tuning by init
allow storaged sysfs_devices_block:dir r_dir_perms;
allow storaged sysfs_devices_block:file r_file_perms;
allow init sysfs_devices_block:file w_file_perms;

# minigbm/Mesa probe optional vendor.* debug properties everywhere; reading them is
# not needed (the defaults apply), silence the noise.
dontaudit {
  appdomain
  bootanim
  surfaceflinger
  system_server
  mediaswcodec
  cameraserver
} vendor_default_prop:file { getattr open read map };

# --- Video decoders (rkvdec, Hantro): /dev/video* + /dev/media* are video_device
# (file_contexts); mediacodec already has rw access to it.

# --- Bluetooth HAL toggles the radio through /dev/rfkill.
type rfkill_device, dev_type;
allow hal_bluetooth_default rfkill_device:chr_file rw_file_perms;

# --- USB gadget HAL (adb/MTP switching)
allow hal_usb_gadget_default functionfs:dir { watch watch_reads };
get_prop(hal_usb_gadget_default, usb_control_prop)

# --- Gatekeeper also serves ISharedSecret/gatekeeper (labelled hal_gatekeeper_service in
# service_contexts, as on the emulator), so keystore's shared-secret negotiation reaches it.

# --- Kernel loads Wi-Fi/BT firmware from /vendor/etc/firmware
# (firmware_class.path=/vendor/etc/firmware).
allow kernel vendor_configs_file:system firmware_load;
dontaudit kernel device:blk_file { create setattr unlink };

# --- Audio HAL card selection is a vendor property set from init.
set_prop(vendor_init, vendor_audio_prop)
