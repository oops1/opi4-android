# Google apps from removable storage (device/opi4/gapps): unpacks MindTheGapps into
# /data/vendor/gapps and overlays it read-only on the app directories before zygote.
type opi4_gapps, domain;
type opi4_gapps_exec, exec_type, vendor_file_type, file_type;
type opi4_gapps_data_file, file_type, data_file_type;
init_daemon_domain(opi4_gapps)

# unpack
allow opi4_gapps opi4_gapps_data_file:dir create_dir_perms;
allow opi4_gapps opi4_gapps_data_file:file create_file_perms;
allow opi4_gapps opi4_gapps_data_file:chr_file { create getattr unlink };
allow opi4_gapps self:capability mknod;
allow opi4_gapps vendor_data_file:dir search;

# read the zip from USB/SD storage mounted by vold
allow opi4_gapps mnt_media_rw_file:dir r_dir_perms;
allow opi4_gapps { vfat exfat }:dir r_dir_perms;
allow opi4_gapps { vfat exfat }:file r_file_perms;

# overlay mounts (overlayfs keeps checking the mounter's rights on both layers)
allow opi4_gapps system_file:dir { mounton r_dir_perms };
allow opi4_gapps system_file:file { r_file_perms map };
allow opi4_gapps opi4_gapps_data_file:dir r_dir_perms;
allow opi4_gapps opi4_gapps_data_file:file { r_file_perms map };
allow opi4_gapps labeledfs:filesystem { mount relabelfrom relabelto };
allow opi4_gapps system_file:filesystem associate;

# state + reboot request (init does the reboot)
type vendor_opi4_gapps_prop, property_type;
vendor_internal_prop(vendor_opi4_gapps_prop)
set_prop(opi4_gapps, vendor_opi4_gapps_prop)
