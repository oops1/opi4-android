# Google apps from removable storage (device/opi4/gapps): the installer unpacks
# MindTheGapps into /data/vendor/gapps; init overlays it read-only on the app
# directories before zygote (opi4_gapps.rc). Only init may mount over system files.
type opi4_gapps, domain;
type opi4_gapps_exec, exec_type, vendor_file_type, file_type;
type opi4_gapps_data_file, file_type, data_file_type;
init_daemon_domain(opi4_gapps)

# unpack
allow opi4_gapps vendor_data_file:dir search;
allow opi4_gapps opi4_gapps_data_file:dir create_dir_perms;
allow opi4_gapps opi4_gapps_data_file:file create_file_perms;

# read the zip from USB/SD storage mounted by vold
allow opi4_gapps mnt_media_rw_file:dir r_dir_perms;
allow opi4_gapps { vfat exfat }:dir r_dir_perms;
allow opi4_gapps { vfat exfat }:file r_file_perms;

# state + reboot request (init does the reboot)
vendor_internal_prop(vendor_opi4_gapps_prop)
set_prop(opi4_gapps, vendor_opi4_gapps_prop)

# init mounts the overlays; overlayfs keeps checking the mounter's rights on the layers
allow init opi4_gapps_data_file:dir { mounton r_dir_perms };
allow init opi4_gapps_data_file:file { r_file_perms map };
