# Google apps from removable storage (opi4_gapps.cpp).
# Before zygote scans the app directories, init loop-mounts the image built from the
# MindTheGapps zip (if any) and overlays its directories on top of the image's own,
# read-only, with the labels of system files. Without an image every mount just fails.
# context= also labels the superblocks system_file (statfs: opi4_gapps.te).

on post-fs-data
    mkdir /data/vendor/gapps 0700 root root
    mkdir /mnt/vendor/gapps 0755 root root
    mount ext4 loop@/data/vendor/gapps/gapps.img /mnt/vendor/gapps ro nodev nosuid context=u:object_r:system_file:s0
    mount overlay overlay /product/app ro lowerdir=/mnt/vendor/gapps/product/app:/product/app,context=u:object_r:system_file:s0
    mount overlay overlay /product/priv-app ro lowerdir=/mnt/vendor/gapps/product/priv-app:/product/priv-app,context=u:object_r:system_file:s0
    mount overlay overlay /product/overlay ro lowerdir=/mnt/vendor/gapps/product/overlay:/product/overlay,context=u:object_r:system_file:s0
    mount overlay overlay /product/lib64 ro lowerdir=/mnt/vendor/gapps/product/lib64:/product/lib64,context=u:object_r:system_lib_file:s0
    mount overlay overlay /product/etc/security ro lowerdir=/mnt/vendor/gapps/product/etc/security:/product/etc/security,context=u:object_r:system_file:s0
    mount overlay overlay /product/framework ro lowerdir=/mnt/vendor/gapps/product/framework:/product/framework,context=u:object_r:system_file:s0
    mount overlay overlay /product/etc/permissions ro lowerdir=/mnt/vendor/gapps/product/etc/permissions:/product/etc/permissions,context=u:object_r:system_file:s0
    mount overlay overlay /product/etc/sysconfig ro lowerdir=/mnt/vendor/gapps/product/etc/sysconfig:/product/etc/sysconfig,context=u:object_r:system_file:s0
    mount overlay overlay /product/etc/default-permissions ro lowerdir=/mnt/vendor/gapps/product/etc/default-permissions:/product/etc/default-permissions,context=u:object_r:system_file:s0
    mount overlay overlay /system/app ro lowerdir=/mnt/vendor/gapps/system/app:/system/app,context=u:object_r:system_file:s0
    mount overlay overlay /system/priv-app ro lowerdir=/mnt/vendor/gapps/system/priv-app:/system/priv-app,context=u:object_r:system_file:s0
    mount overlay overlay /system/etc/permissions ro lowerdir=/mnt/vendor/gapps/system/etc/permissions:/system/etc/permissions,context=u:object_r:system_file:s0
    mount overlay overlay /system_ext/app ro lowerdir=/mnt/vendor/gapps/system_ext/app:/system_ext/app,context=u:object_r:system_file:s0
    mount overlay overlay /system_ext/priv-app ro lowerdir=/mnt/vendor/gapps/system_ext/priv-app:/system_ext/priv-app,context=u:object_r:system_file:s0
    mount overlay overlay /system_ext/etc/permissions ro lowerdir=/mnt/vendor/gapps/system_ext/etc/permissions:/system_ext/etc/permissions,context=u:object_r:system_file:s0
    # The stand-in launcher and setup app give way to Google's: an empty directory from
    # the image is mounted over them (exists only when Google apps are installed).
    mount none /mnt/vendor/gapps/hide /product/priv-app/TvSampleLeanbackLauncher bind
    mount none /mnt/vendor/gapps/hide /product/app/TvSampleLeanbackLauncher bind
    mount none /mnt/vendor/gapps/hide /product/priv-app/TvProvision bind
    mount none /mnt/vendor/gapps/hide /product/app/TvProvision bind

service vendor.opi4_gapps_install /vendor/bin/opi4_gapps
    user root
    group root media_rw
    disabled

# Watch removable storage (vold mounts it under /mnt/media_rw) for MindTheGapps-*.zip.
on property:sys.boot_completed=1
    start vendor.opi4_gapps_install

# The reboot after an install/removal is requested from opi4_gapps_reboot.rc (system_ext):
# commands of vendor scripts run as vendor_init, which may not set sys.powerctl.
