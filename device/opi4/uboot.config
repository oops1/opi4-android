# Orange Pi 4 U-Boot fragment (merged before GloDroid's common fragments).
# Armbian's defconfig keeps the environment on MMC at 4 MiB, which is inside the Android
# GPT partitions here; GloDroid boots from boot.scr, so do not store an environment at all.
# CONFIG_ENV_IS_IN_MMC is not set
CONFIG_ENV_IS_NOWHERE=y

# binman places u-boot.itb at SPL_PAD_TO (0x40000) after the idbloader, which itself sits at
# sector 64 (32K): 0x8000 + 0x40000 = 0x48000 = sector 0x240. U-Boot 2025.01 keeps the
# rk3399 default of sector 0x4000 (8 MiB) here, which is inside GloDroid's boot_a partition.
CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR=0x240

# 'ums 0 mmc 1' exposes the SD card (or 'mmc 0' = eMMC) to the PC over the Type-C port as a
# plain USB disk: partitions can be updated from Windows without moving the card or a driver.
CONFIG_CMD_USB_MASS_STORAGE=y
CONFIG_USB_FUNCTION_MASS_STORAGE=y
